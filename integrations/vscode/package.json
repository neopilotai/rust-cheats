{
  "name": "rust-cheats-vscode",
  "displayName": "Rust Cheats",
  "description": "Search local programming cheat sheets from VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Programming Languages"],
  "activationEvents": ["onCommand:rustCheats.search"],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  },
  "contributes": {
    "commands": [
      { "command": "rustCheats.search", "title": "Rust Cheats: Search Cheat Sheets" }
    ]
  }
}
